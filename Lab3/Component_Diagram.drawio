        <mxCell id="title" value="UML COMPONENT DIAGRAM — RESTAURANT TABLE BOOKING &amp; PRE-ORDERING APP" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;strokeColor=none;fillColor=none;" vertex="1" edge="0" parent="1"><mxGeometry x="150" y="20" width="1100" height="36" as="geometry"/></mxCell><mxCell id="subtitle" value="Selected architecture: Layered Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" edge="0" parent="1"><mxGeometry x="350" y="58" width="700" height="24" as="geometry"/></mxCell><mxCell id="layer_p" value="PRESENTATION LAYER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#777777;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;" vertex="1" edge="0" parent="1"><mxGeometry x="260" y="100" width="880" height="135" as="geometry"/></mxCell><mxCell id="layer_b" value="BUSINESS LAYER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#777777;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;" vertex="1" edge="0" parent="1"><mxGeometry x="120" y="270" width="1160" height="205" as="geometry"/></mxCell><mxCell id="layer_i" value="SERVICE / INTEGRATION LAYER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#777777;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;" vertex="1" edge="0" parent="1"><mxGeometry x="120" y="510" width="1160" height="190" as="geometry"/></mxCell><mxCell id="ui" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Diner / Manager Interface&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Floor plan, reservation and order screens&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=14;spacing=6;" v